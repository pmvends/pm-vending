---
import Section from '../Section.astro';
import { process } from '../../data/site';

/**
 * An ordered list, because the steps genuinely happen in sequence and screen
 * reader users benefit from hearing the count. The numbers are rendered rather
 * than left to list markers so they can carry the heading font.
 */
---

<Section id="how-it-works" surface="subtle" labelledBy="how-it-works-heading">
  <h2 id="how-it-works-heading" class="text-h2">How it works</h2>
  <p class="mt-4 max-w-[var(--measure)] text-body-lg text-foreground-muted">
    Four steps, starting with an email. Nothing is committed until you have seen what is
    going in the machine.
  </p>

  <ol class="mt-12 grid gap-x-16 gap-y-10 md:grid-cols-2">
    {
      process.map(({ title, body }, index) => (
        <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 border-t border-border pt-6">
          <span
            class="font-heading text-h3 text-brand-ink tabular-nums"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="text-h4">{title}</h3>
            <p class="mt-2 text-body text-foreground-muted">{body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
